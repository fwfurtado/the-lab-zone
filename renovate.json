{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMultipleMajorReleases"
  ],
  "timezone": "America/Sao_Paulo",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 6,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "replace",
  "commitMessagePrefix": "chore(deps):",
  "dependencyDashboardTitle": "Dependency Dashboard",
  "assigneesFromCodeOwners": true,
  "ignorePaths": [
    "apps/core/gateway-api-crds/crd/**",
    "**/.terraform/**",
    "**/target/**"
  ],
  "packageRules": [
    {
      "description": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Terraform providers and modules",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "terraform",
      "rangeStrategy": "replace"
    },
    {
      "description": "Terraform Core runtime is controlled by .mise.toml",
      "matchManagers": [
        "terraform"
      ],
      "matchDatasources": [
        "terraform-version"
      ],
      "enabled": false
    },
    {
      "description": "mise tool versions",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise-tools"
    },
    {
      "description": "Core platform Helm charts",
      "matchFileNames": [
        "apps/core/**/app.yaml"
      ],
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "groupName": "helm-core"
    },
    {
      "description": "Observability Helm charts",
      "matchFileNames": [
        "apps/observability/**/app.yaml"
      ],
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "groupName": "helm-observability"
    },
    {
      "description": "Data platform Helm charts",
      "matchFileNames": [
        "apps/data/**/app.yaml"
      ],
      "matchDatasources": [
        "helm",
        "docker",
        "git-tags"
      ],
      "groupName": "helm-data"
    },
    {
      "description": "AI Helm charts",
      "matchFileNames": [
        "apps/ai/**/app.yaml"
      ],
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "groupName": "helm-ai"
    },
    {
      "description": "Security Helm charts",
      "matchFileNames": [
        "apps/security/**/app.yaml"
      ],
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "groupName": "helm-security"
    },
    {
      "description": "Utility container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine/git",
        "busybox",
        "curlimages/curl",
        "rclone/rclone"
      ],
      "groupName": "container-images-utils",
      "separateMajorMinor": true
    },
    {
      "description": "MCP container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/grafana/mcp-grafana",
        "docker.io/isokoliuk/mcp-searxng",
        "ghcr.io/containers/kubernetes-mcp-server",
        "ghcr.io/fwfurtado/mcp-server-qdrant",
        "ghcr.io/github/github-mcp-server",
        "ghcr.io/victoriametrics/mcp-victorialogs",
        "ghcr.io/victoriametrics/mcp-victoriametrics",
        "ofwfurtado/mcp-for-argocd",
        "ofwfurtado/mcp-server-qdrant"
      ],
      "groupName": "container-images-mcp",
      "separateMajorMinor": true
    },
    {
      "description": "AI runtime container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/us/crw",
        "ollama/ollama",
        "vllm/vllm-openai"
      ],
      "groupName": "container-images-ai-runtime",
      "separateMajorMinor": true
    },
    {
      "description": "Data store container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "clickhouse/clickhouse-server",
        "docker.io/library/postgres",
        "docker.io/library/redis"
      ],
      "groupName": "container-images-data",
      "separateMajorMinor": true
    },
    {
      "description": "Backup and DR container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "altinity/clickhouse-backup",
        "velero/velero-plugin-for-aws"
      ],
      "groupName": "container-images-backup-dr",
      "separateMajorMinor": true
    },
    {
      "description": "Authentik VM container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/goauthentik/server"
      ],
      "groupName": "container-images-authentik",
      "separateMajorMinor": true
    },
    {
      "description": "Application-owned container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/fwfurtado/dbt-runner",
        "ghcr.io/fwfurtado/goose-runner",
        "ghcr.io/fwfurtado/qa-indexer",
        "ghcr.io/fwfurtado/the-lab-zone-agents-core",
        "ghcr.io/fwfurtado/the-lab-zone-agents-triage-webhook",
        "ghcr.io/fwfurtado/triage-indexer"
      ],
      "groupName": "container-images-apps",
      "separateMajorMinor": true
    },

    {
      "description": "Do not automerge infrastructure updates",
      "matchManagers": [
        "terraform",
        "github-actions",
        "mise",
        "kubernetes",
        "custom.regex"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Argo CD Helm charts from HTTP Helm repositories",
      "managerFilePatterns": [
        "/(^|/)apps/.+/app\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)-\\s+repoURL:\\s+(?<registryUrl>https?://[^\\s#]+)[^\\n]*\\n\\s+chart:\\s+(?<depName>[^\\s#]+)\\n\\s+targetRevision:\\s+[\"']?(?<currentValue>[^\"'\\s#]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Argo CD Helm charts from OCI registries",
      "managerFilePatterns": [
        "/(^|/)apps/.+/app\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)-\\s+repoURL:\\s+(?<registryUrl>(?:ghcr\\.io|docker\\.io|quay\\.io|registry\\.k8s\\.io)/[^\\s#]+)[^\\n]*\\n\\s+chart:\\s+(?<depName>[^\\s#]+)\\n\\s+targetRevision:\\s+[\"']?(?<currentValue>[^\"'\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{{registryUrl}}}/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Garage Helm chart from upstream Git tag",
      "managerFilePatterns": [
        "/^apps/data/garage/app\\.ya?ml$/"
      ],
      "matchStrings": [
        "repoURL:\\s+(?<depName>https://git\\.deuxfleurs\\.fr/Deuxfleurs/garage\\.git)[\\s\\S]*?path:\\s+script/helm/garage[\\s\\S]*?targetRevision:\\s+(?<currentValue>v?[^\\s#]+)"
      ],
      "datasourceTemplate": "git-tags"
    },
    {
      "customType": "regex",
      "description": "Container images in YAML, including CRDs and Helm values",
      "managerFilePatterns": [
        "/(^|/)(apps|infra)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)\\s*image:\\s+[\"']?(?<depName>[^\\s\"'{}@#:]+(?:/[^\\s\"'{}@#:]+)*):(?<currentValue>[^\\s\"'{}@#]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
